<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infraestructura "técnica" que NO es base de datos: seguridad (JWT, BCrypt)
    y caché. Implementa interfaces definidas en Application
    (IPasswordHasher, IJwtTokenGenerator, IActiveUserCache, IPermissionCache).
    La persistencia sigue en Inventory.Infrastructure.Persistence.SqlServer.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
  </ItemGroup>

</Project>
